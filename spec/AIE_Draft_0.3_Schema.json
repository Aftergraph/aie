{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aie.open/schema/0.3.0/institution.schema.json",
  "title": "AIE Draft 0.3 Institution Manifest",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "schemaVersion",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "aie.open/v0alpha4"
    },
    "kind": {
      "const": "Institution"
    },
    "schemaVersion": {
      "const": "0.3.0"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "conformance",
        "principals",
        "authority",
        "missions",
        "policy",
        "evidence",
        "registries",
        "bindings"
      ],
      "properties": {
        "conformance": {
          "type": "object",
          "required": [
            "profiles",
            "suiteVersion"
          ],
          "properties": {
            "profiles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "C0",
                  "D1",
                  "T1",
                  "F1",
                  "E1"
                ]
              },
              "contains": {
                "const": "C0"
              }
            },
            "suiteVersion": {
              "const": "0.3.0"
            }
          },
          "additionalProperties": false
        },
        "trustDomain": {
          "type": "string"
        },
        "principals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "identityRef"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "human",
                  "agent",
                  "service",
                  "tool"
                ]
              },
              "identityRef": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "roles": {
          "type": "object"
        },
        "authority": {
          "type": "object",
          "required": [
            "resolution",
            "delegation",
            "revocation"
          ],
          "properties": {
            "defaultTTL": {
              "type": "string"
            },
            "resolution": {
              "type": "object",
              "required": [
                "algorithm",
                "requireExecutionTimeValidation",
                "replayProtection"
              ],
              "properties": {
                "algorithm": {
                  "const": "aie-core-v1"
                },
                "requireExecutionTimeValidation": {
                  "const": true
                },
                "replayProtection": {
                  "enum": [
                    "action-id"
                  ]
                }
              },
              "additionalProperties": true
            },
            "delegation": {
              "type": "object",
              "required": [
                "maxDepth",
                "attenuateScope",
                "conserveBudget",
                "descendantRevocation"
              ],
              "properties": {
                "maxDepth": {
                  "type": "integer",
                  "minimum": 0
                },
                "attenuateScope": {
                  "const": true
                },
                "conserveBudget": {
                  "const": true
                },
                "descendantRevocation": {
                  "enum": [
                    "bounded-propagation"
                  ]
                }
              },
              "additionalProperties": true
            },
            "revocation": {
              "type": "object",
              "required": [
                "freshnessObjective",
                "onUnknownFreshness"
              ],
              "properties": {
                "freshnessObjective": {
                  "type": "string",
                  "minLength": 1
                },
                "onUnknownFreshness": {
                  "enum": [
                    "deny-protected-actions"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "missions": {
          "type": "object"
        },
        "budgets": {
          "type": "object"
        },
        "topology": {
          "type": "object"
        },
        "policy": {
          "type": "object",
          "required": [
            "engine",
            "defaultDecision"
          ],
          "properties": {
            "engine": {
              "type": "string",
              "minLength": 1
            },
            "defaultDecision": {
              "const": "deny"
            }
          },
          "additionalProperties": true
        },
        "evidence": {
          "type": "object",
          "required": [
            "minimizePayloads",
            "digestAlgorithm",
            "requiredEvents"
          ],
          "properties": {
            "minimizePayloads": {
              "type": "boolean"
            },
            "digestAlgorithm": {
              "type": "string",
              "minLength": 1
            },
            "requiredEvents": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "registries": {
          "type": "object",
          "required": [
            "errorCodes",
            "eventTypes",
            "extensionPolicy"
          ],
          "properties": {
            "errorCodes": {
              "const": "aie-core-errors@0.3"
            },
            "eventTypes": {
              "const": "aie-core-events@0.3"
            },
            "extensionPolicy": {
              "const": "aie-extension-policy@0.3"
            }
          },
          "additionalProperties": false
        },
        "bindings": {
          "type": "object",
          "required": [
            "tools",
            "agents",
            "identity",
            "policy",
            "telemetry",
            "runtimeControl"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "namespace",
              "version",
              "critical",
              "payload"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "critical": {
                "type": "boolean"
              },
              "payload": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}